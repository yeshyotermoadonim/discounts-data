{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yesh Yoter Moadonim Data Schema",
  "description": "JSON Schema for clubs.json, brands.json, listings.json, and categories.json",
  "definitions": {
    "category": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "club": {
      "type": "object",
      "required": ["id", "name", "nameEn", "url", "color", "active"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "active": { "type": "boolean" }
      }
    },
    "brand": {
      "type": "object",
      "required": ["id", "name", "categories", "logoUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "logoUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    },
    "listing": {
      "type": "object",
      "required": ["brandId", "clubId", "online", "url"],
      "additionalProperties": false,
      "properties": {
        "brandId": { "type": "string" },
        "clubId": { "type": "string" },
        "online": {
          "type": "boolean",
          "description": "Online redemption for this brand in this club"
        },
        "url": { "type": "string", "format": "uri" }
      }
    }
  },
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/category" }
    },
    "clubs": {
      "type": "array",
      "items": { "$ref": "#/definitions/club" }
    },
    "brands": {
      "type": "array",
      "items": { "$ref": "#/definitions/brand" }
    },
    "listings": {
      "type": "array",
      "items": { "$ref": "#/definitions/listing" }
    }
  }
}
